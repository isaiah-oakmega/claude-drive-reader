# Token Broker 需要的環境變數（C5）。本機開發時複製成 .env 再填值；.env 不會進入版本控制。
# 正式環境由 Cloud Run 設定，GOOGLE_CLIENT_SECRET 從 Secret Manager 讀取，不寫在任何檔案裡。

# OAuth Client ID（不是機密）
GOOGLE_CLIENT_ID=

# OAuth Client secret（機密）
GOOGLE_CLIENT_SECRET=

# Broker 對外的網址，不含結尾斜線；redirect_uri 一律是 ${PUBLIC_BASE_URL}/callback（B5）
PUBLIC_BASE_URL=
